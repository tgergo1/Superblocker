# Debug mode
DEBUG=false

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Nominatim API settings
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Superblocker/1.0 (https://github.com/tgergo1/Superblocker)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0

# OSM settings
OSM_TIMEOUT=180
OSM_MEMORY_LIMIT=1073741824
MAX_BBOX_SPAN_DEGREES=0.5
MAX_BBOX_AREA_KM2=2500

# Expensive workload protection
ANALYSIS_MAX_WORKERS=2
ANALYSIS_MAX_CONCURRENT_REQUESTS=2
ANALYSIS_RATE_LIMIT_PER_MINUTE=6
PARTITION_CACHE_MAX_ENTRIES=8
PARTITION_CACHE_TTL_SECONDS=3600

# Required as X-Admin-Key for cache deletion/cleanup endpoints
ADMIN_API_KEY=replace-with-a-long-random-secret

# Cache settings
CACHE_ENABLED=true
CACHE_DIR=cache
CACHE_TTL_SECONDS=86400
CACHE_NETWORK_TTL_SECONDS=604800
CACHE_ANALYSIS_TTL_SECONDS=86400
CACHE_SEARCH_TTL_SECONDS=3600
