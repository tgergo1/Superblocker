# Leave unset for same-origin nginx proxying and the Vite development proxy.
# Set only when the API is served from a different origin.
VITE_API_URL=/api/v1

# Optional OSM-compatible raster tile template. The default is the official
# no-key OpenStreetMap tile endpoint used by the local prototype.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
